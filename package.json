{
  "name": "spotify-player-rn",
  "version": "1.0.0",
  "description": "Full-featured Spotify player clone for React Native/Expo",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "eas build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "expo": "^51.0.0",
    "expo-router": "^3.5.0",
    "expo-av": "^14.0.0",
    "expo-crypto": "^13.0.0",
    "@expo/vector-icons": "^14.0.0",
    "expo-document-picker": "^11.2.0",
    "expo-media-library": "^15.0.0",
    "expo-secure-store": "^12.0.0",
    "expo-linking": "^6.0.0",
    "expo-web-browser": "^12.0.0",
    "react": "18.3.1",
    "react-native": "0.74.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-screens": "^3.29.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.7.0",
    "react-native-svg": "^14.1.0",
    "zustand": "^4.5.0",
    "axios": "^1.7.0",
    "crypto-js": "^4.2.0",
    "axios-retry": "^3.8.0",
    "uuid": "^9.0.0",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "expo-file-system": "^15.0.0",
    "id3-parser": "^0.4.5",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.73.0",
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "typescript": "^5.4.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.1.0",
    "jest": "^29.0.0",
    "@testing-library/react-native": "^12.0.0",
    "ts-jest": "^29.0.0"
  },
  "expo": {
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your music files.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save music."
        }
      ]
    ]
  }
}
